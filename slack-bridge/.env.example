# Copy this file to .env (same folder) and fill it in.
# .env holds a live secret. It is git-ignored. Never commit it, never paste it in chat.

# The bot token from OAuth & Permissions at api.slack.com/apps. Starts with xoxb-.
SLACK_BOT_TOKEN=xoxb-your-token

# Your main channel, label "main". A PRIVATE channel with the bot invited.
# Find it: open the channel, click its name, scroll to the bottom of About.
SLACK_CHANNEL_ID=C0123456789

# Optional extra channels. The part after SLACK_CHANNEL_ becomes the label,
# lowercased: this one is "team", used as --channel team. Add as many as you like.
# SLACK_CHANNEL_TEAM=C0123456789

# Who may talk to your Claude. Slack user IDs, comma-separated, no spaces needed.
# Anyone else who posts in the channel is reported by ID with their text withheld.
# Required: with this line missing, the tools refuse to start.
# Find an ID: click the person's profile, the three dots, "Copy member ID".
SLACK_ALLOWED_USERS=U0123456789,U0987654321
