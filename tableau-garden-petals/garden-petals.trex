<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.datadivers.vizext.gardenpetals" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Garden Petals: one flower per row of your data, one petal per category, petal length set by a measure. Grid, a garden map that plants each flower at its location, or an altitude view. Reference outlines, frost, wilt, shape-twin bees and a close-up bloom, all adjustable from a settings panel inside the viz.</description>
    <author name="Chris Fryar" organization="Data Divers" website="https://datadivers.com"/>
    <min-api-version>1.12</min-api-version>
    <source-location>
      <url>http://localhost:8767/src/index.html</url>
    </source-location>
    <icon/>
    <permissions>
      <permission>full data</permission>
    </permissions>

    <encoding id="flower">
      <display-name resource-id="enc-flower">Flower</display-name>
      <data-spec>
        <data-type>string</data-type>
      </data-spec>
      <role-spec>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="letter-f"/>
      <tooltip resource-id="tip-flower">The dimension that gives each flower its own spot, such as Country.</tooltip>
    </encoding>

    <encoding id="petal">
      <display-name resource-id="enc-petal">Petal</display-name>
      <data-spec>
        <data-type>string</data-type>
      </data-spec>
      <role-spec>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="letter-p"/>
      <tooltip resource-id="tip-petal">The dimension that makes the petals around each flower, such as Metric.</tooltip>
    </encoding>

    <encoding id="length">
      <display-name resource-id="enc-length">Length</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="letter-l"/>
      <tooltip resource-id="tip-length">The measure that sets how long each petal grows.</tooltip>
    </encoding>

    <encoding id="score">
      <display-name resource-id="enc-score">Score</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="letter-s"/>
      <tooltip resource-id="tip-score">Optional. One number per flower. Used for sorting, the altitude view and the label in the center of the close-up.</tooltip>
    </encoding>
  </worksheet-extension>

  <resources>
    <resource id="name">
      <text locale="en_US">Garden Petals</text>
    </resource>
    <resource id="enc-flower">
      <text locale="en_US">Flower</text>
    </resource>
    <resource id="enc-petal">
      <text locale="en_US">Petal</text>
    </resource>
    <resource id="enc-length">
      <text locale="en_US">Length</text>
    </resource>
    <resource id="enc-score">
      <text locale="en_US">Score</text>
    </resource>
    <resource id="tip-flower">
      <text locale="en_US">The dimension that gives each flower its own spot, such as Country.</text>
    </resource>
    <resource id="tip-petal">
      <text locale="en_US">The dimension that makes the petals around each flower, such as Metric.</text>
    </resource>
    <resource id="tip-length">
      <text locale="en_US">The measure that sets how long each petal grows.</text>
    </resource>
    <resource id="tip-score">
      <text locale="en_US">Optional. One number per flower.</text>
    </resource>
  </resources>
</manifest>
